---
interface Props {
	/** The snippet, verbatim. Passed as a prop rather than a slot so the
	 *  indentation of the page's markup never reaches the block. */
	code: string;
}

const { code } = Astro.props;
---

<pre
	class="my-4 overflow-x-auto rounded-lg border border-neutral-200 bg-neutral-50 p-4 text-sm leading-relaxed dark:border-neutral-800 dark:bg-neutral-900"><code
		class="font-mono text-neutral-800 dark:text-neutral-200">{code}</code></pre>
