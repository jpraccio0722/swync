---
import Layout from "./Layout.astro";
import { TUTORIAL, neighbors } from "../lib/tutorial";

interface Props {
	title: string;
	description?: string;
	/** The slug of the chapter being read, so the contents can mark it. */
	current: string;
}

const { title, description, current } = Astro.props;
const { prev, next } = neighbors(current);

const link = (slug: string) =>
	"flex items-center gap-2 rounded-md px-2 py-1 text-sm transition-colors " +
	(current === slug
		? "bg-neutral-100 font-medium text-neutral-900 dark:bg-neutral-900 dark:text-neutral-100"
		: "text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100");
---

<Layout title={`${title} · Swync`} description={description}>
	<div class="mx-auto flex max-w-6xl gap-10 px-6 py-10">
		<aside class="hidden w-56 shrink-0 lg:block">
			<div class="sticky top-10 space-y-6">
				<a
					href="/"
					class="block text-sm font-semibold tracking-tight hover:text-blue-700 dark:hover:text-blue-400"
				>
					Swync
				</a>

				<nav aria-label="Tutorial contents">
					<p class="mb-2 text-xs font-semibold uppercase tracking-wide text-neutral-500">
						Tutorial
					</p>
					<ul class="space-y-0.5">
						{
							TUTORIAL.map((page, i) => (
								<li>
									<a
										href={`/tutorial/${page.slug}/`}
										aria-current={current === page.slug ? "page" : undefined}
										class={link(page.slug)}
									>
										<span class="font-mono text-[10px] text-neutral-500">
											{i + 1}
										</span>
										<span class="flex-1">{page.title}</span>
									</a>
								</li>
							))
						}
					</ul>
				</nav>

				<nav aria-label="Elsewhere">
					<ul class="space-y-0.5">
						<li>
							<a href="/docs/" class={link("")}>Function reference</a>
						</li>
					</ul>
				</nav>
			</div>
		</aside>

		<div class="min-w-0 flex-1">
			{/* Below `lg` the sidebar is gone, so the contents ride above the
			    chapter instead — on a phone this is the only way to the rest of
			    the tutorial. */}
			<nav aria-label="Tutorial contents" class="mb-8 lg:hidden">
				<p class="mb-2 text-xs font-semibold uppercase tracking-wide text-neutral-500">
					Tutorial
				</p>
				<ul class="flex flex-wrap gap-x-3 gap-y-1">
					{
						TUTORIAL.map((page) => (
							<li>
								<a
									href={`/tutorial/${page.slug}/`}
									aria-current={current === page.slug ? "page" : undefined}
									class={
										"text-sm " +
										(current === page.slug
											? "font-medium text-neutral-900 dark:text-neutral-100"
											: "text-neutral-600 hover:text-blue-700 dark:text-neutral-400 dark:hover:text-blue-400")
									}
								>
									{page.title}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<slot />

			{
				(prev || next) && (
					<nav
						aria-label="Chapters"
						class="mt-12 flex justify-between gap-6 border-t border-neutral-200 pt-6 text-sm dark:border-neutral-800"
					>
						{prev ? (
							<a
								href={`/tutorial/${prev.slug}/`}
								class="text-blue-700 hover:underline dark:text-blue-400"
							>
								← {prev.title}
							</a>
						) : (
							<span />
						)}
						{next && (
							<a
								href={`/tutorial/${next.slug}/`}
								class="text-right text-blue-700 hover:underline dark:text-blue-400"
							>
								{next.title} →
							</a>
						)}
					</nav>
				)
			}
		</div>
	</div>
</Layout>
