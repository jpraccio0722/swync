---
import Layout from "./Layout.astro";
import ReferenceSearch from "../components/ReferenceSearch.tsx";
import { categories, membersOf, searchEntries } from "../lib/reference";

interface Props {
	title: string;
	description?: string;
	/** The slug of the category being read, so the sidebar can mark it. */
	current?: string;
}

const { title, description, current } = Astro.props;

const nav = await Promise.all(
	(await categories()).map(async (c) => ({
		slug: c.id,
		label: c.data.label,
		count: (await membersOf(c.id)).length,
	})),
);
const entries = await searchEntries();
---

<Layout title={`${title} · Swync`} description={description}>
	<div class="mx-auto flex max-w-6xl gap-10 px-6 py-10">
		<aside class="hidden w-56 shrink-0 lg:block">
			<div class="sticky top-10 space-y-6">
				<a
					href="/"
					class="block text-sm font-semibold tracking-tight hover:text-blue-700 dark:hover:text-blue-400"
				>
					Swync
				</a>

				<nav aria-label="Reference categories">
					<p class="mb-2 text-xs font-semibold uppercase tracking-wide text-neutral-500">
						Reference
					</p>
					<ul class="space-y-0.5">
						{
							nav.map((c) => (
								<li>
									<a
										href={`/docs/${c.slug}/`}
										aria-current={current === c.slug ? "page" : undefined}
										class={
											"flex items-center gap-2 rounded-md px-2 py-1 text-sm transition-colors " +
											(current === c.slug
												? "bg-neutral-100 font-medium text-neutral-900 dark:bg-neutral-900 dark:text-neutral-100"
												: "text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100")
										}
									>
										<span class="flex-1">{c.label}</span>
										<span class="font-mono text-[10px] text-neutral-500">
											{c.count}
										</span>
									</a>
								</li>
							))
						}
					</ul>
				</nav>

				<nav aria-label="Elsewhere">
					<ul class="space-y-0.5">
						<li>
							<a
								href="/tutorial/getting-started/"
								class="flex items-center gap-2 rounded-md px-2 py-1 text-sm text-neutral-600 transition-colors hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
							>
								Tutorial
							</a>
						</li>
					</ul>
				</nav>
			</div>
		</aside>

		<div class="min-w-0 flex-1">
			<div class="mb-8 max-w-md">
				<ReferenceSearch entries={entries} client:load />
			</div>
			<slot />
		</div>
	</div>
</Layout>
