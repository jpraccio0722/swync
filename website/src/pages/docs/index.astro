---
import DocsLayout from "../../layouts/DocsLayout.astro";
import { CATEGORIES, membersOf, signature } from "../../lib/reference";

const groups = CATEGORIES.map((c) => ({
	...c,
	members: membersOf(c.key),
}));
---

<DocsLayout
	title="Reference"
	description="Every callable name in swync, by category."
>
	<header class="mb-10">
		<h1 class="text-3xl font-semibold tracking-tight">Function Reference</h1>
	</header>

	<div class="space-y-10">
		{
			groups.map((group) => (
				<section>
					<div class="flex items-baseline gap-3">
						<h2 class="text-lg font-semibold tracking-tight">
							<a
								href={`/docs/${group.slug}/`}
								class="hover:text-blue-700 dark:hover:text-blue-400"
							>
								{group.label}
							</a>
						</h2>
						<span class="font-mono text-xs text-neutral-500">
							{group.members.length}
						</span>
					</div>
					<p class="mt-1 max-w-2xl text-sm text-neutral-600 dark:text-neutral-400">
						{group.blurb}
					</p>

					{/* The whole group's signatures, so the index is an index: the
					    shape of the category at a glance, and one click to the prose. */}
					<ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1">
						{group.members.map((b) => (
							<li>
								<a
									href={`/docs/${group.slug}/#${b.name}`}
									class="font-mono text-xs text-neutral-600 hover:text-blue-700 dark:text-neutral-400 dark:hover:text-blue-400"
								>
									{signature(b)}
								</a>
							</li>
						))}
					</ul>
				</section>
			))
		}
	</div>
</DocsLayout>
