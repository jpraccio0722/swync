---
import DocsLayout from "../../layouts/DocsLayout.astro";
import { categories, membersOf, signature } from "../../lib/reference";

const groups = await Promise.all(
	(await categories()).map(async (c) => ({ category: c, members: await membersOf(c.id) })),
);
---

<DocsLayout
	title="Reference"
	description="Every callable name in swync, by category."
>
	<header class="mb-10">
		<h1 class="text-3xl font-semibold tracking-tight">Function Reference</h1>
	</header>

	<div class="space-y-10">
		{
			groups.map(({ category, members }) => (
				<section>
					<div class="flex items-baseline gap-3">
						<h2 class="text-lg font-semibold tracking-tight">
							<a
								href={`/docs/${category.id}/`}
								class="hover:text-blue-700 dark:hover:text-blue-400"
							>
								{category.data.label}
							</a>
						</h2>
						<span class="font-mono text-xs text-neutral-500">
							{members.length}
						</span>
					</div>
					<p class="mt-1 max-w-2xl text-sm text-neutral-600 dark:text-neutral-400">
						{category.data.blurb}
					</p>

					{/* The whole group's signatures, so the index is an index: the
					    shape of the category at a glance, and one click to the prose. */}
					<ul class="mt-3 flex flex-col sgap-y-1">
						{members.map((b) => (
							<li>
								<a
									href={`/docs/${category.id}/#${b.data.name}`}
									class="font-mono text-sm text-neutral-600 hover:text-blue-700 dark:text-neutral-400 dark:hover:text-blue-400"
								>
									{signature(b)}
								</a>
							</li>
						))}
					</ul>
				</section>
			))
		}
	</div>
</DocsLayout>
