---
import Layout from "../layouts/Layout.astro";
import IslandCheck from "../components/IslandCheck.tsx";
---

<Layout title="Swync">
	<main class="mx-auto flex min-h-screen max-w-3xl flex-col justify-center gap-8 px-6 py-16">
		<div class="space-y-3">
			<h1 class="text-6xl font-semibold tracking-tight">Swync</h1>
			<p class="text-lg text-neutral-600 dark:text-neutral-400">
				A rust-like live coding and synthesis language built on top of{" "}
				<a
					class="text-blue-700 hover:underline dark:text-blue-400"
					href="https://github.com/SamiPerttu/fundsp">fundsp</a
				>.
			</p>
		</div>

		<div class="flex flex-col text-md text-neutral-600 dark:text-neutral-400 gap-1.5">
			<h2 class="text-3xl font-semibold text-neutral-50">Features</h2>
			<div><span class="text-md text-neutral-50">Live: </span> change the code, hear it immediately</div>
			<div><span class="text-md text-neutral-50">Musical: </span> work with time signatures, bars, and western note values and pitches</div>
			<div><span class="text-md text-neutral-50">Patterns: </span> lists you can visualize</div>
			<div><span class="text-md text-neutral-50">Arrange: </span> create arrangments through a rich set of pattern chains play/playn/then/then_after</div>
			<div><span class="text-md text-neutral-50">Stochastic form: </span> random choice at a structural level</div>
			<div><span class="text-md text-neutral-50">Rust-like simplicity: </span> let, fn, use, for, ranges, blocks. Synths are functions</div>
		</div>
		
		<div class="flex flex-col gap-1.5">
			<div>
				<a
					href="https://github.com/jpraccio0722/swync/releases"
					class="inline-flex items-center gap-1.5 text-md font-medium text-blue-700 hover:underline dark:text-blue-400"
					target="_blank" rel="noopener noreferrer"
				>Download</a>
			</div>
			<div>
				<a
					href="/tutorial/getting-started/"
					class="inline-flex items-center gap-1.5 text-md font-medium text-blue-700 hover:underline dark:text-blue-400"
				>Tutorial</a>
			</div>
			<div>
				<a
					href="/docs/"
					class="inline-flex items-center gap-1.5 text-md font-medium text-blue-700 hover:underline dark:text-blue-400"
				>Function reference</a>
			</div>
			<div>
				<a
					href="https://github.com/jpraccio0722/swync"
					class="inline-flex items-center gap-1.5 text-md font-medium text-blue-700 hover:underline dark:text-blue-400"
					target="_blank" rel="noopener noreferrer"
				>Github</a>
			</div>	
		</div>
	</main>
</Layout>
